aceName": "Farol de Ponta Negra"}, {"author": "Priscila B.", "text": "Acompanhar a recuperação do lugar é emocionante.", "stars": 3, "date": "2026-11-20T16:45:00Z", "placeId": "restauracao-ecologica-praia-de-ponta-negra", "placeName": "Praia de Ponta Negra"}, {"author": "Gustavo L.", "text": "Ambiente selvagem e tranquilo, perfeito para quem gosta de natureza.", "stars": 4, "date": "2026-11-20T11:26:00Z", "placeId": "praias-e-restinga-praia-de-sacristia", "placeName": "Praia de Sacristia"}, {"author": "Ana M.", "text": "Trilha cercada de árvores enormes. Ouvimos muitos pássaros.", "stars": 4, "date": "2026-11-17T21:50:00Z", "placeId": "mata-atlantica-cachoeira-do-silvado", "placeName": "Cachoeira do Silvado"}, {"author": "Mateus P.", "text": "As formações rochosas são impressionantes, uma aula de geologia.", "stars": 4, "date": "2026-11-15T21:25:00Z", "placeId": "costoes-e-geologia-farol-de-ponta-negra", "placeName": "Farol de Ponta Negra"}, {"author": "Bruna N.", "text": "Subida puxada, mas a vista compensa. Fiquem na trilha principal.", "stars": 4, "date": "2026-11-15T19:14:00Z", "placeId": "mata-atlantica-serra-do-camburi", "placeName": "Serra do Camburi"}, {"author": "Rodrigo M.", "text": "Ótimo para caminhar e observar as corujas-buraqueiras, de longe.", "stars": 3, "date": "2026-11-15T16:15:00Z", "placeId": "lagoas-lagoa-das-amendoeiras", "placeName": "Lagoa das Amendoeiras"}, {"author": "Gustavo L.", "text": "Aprendemos muito sobre o meio ambiente da região. Ótimo para escolas.", "stars": 5, "date": "2026-11-14T14:38:00Z", "placeId": "educacao-ambiental-aldeia-indigena-mata-verde-bonita", "placeName": "Aldeia Indígena Mata Verde Bonita"}, {"author": "Vanessa V.", "text": "Lugar lindo e silencioso. Respeitem as placas e fiquem na trilha.", "stars": 4, "date": "2026-11-13T11:05:00Z", "placeId": "areas-protegidas-parque-ecologico", "placeName": "Parque Ecológico"}, {"author": "Helena F.", "text": "Rochas com bilhões de anos... que coisa incrível.", "stars": 4, "date": "2026-11-10T13:28:00Z", "placeId": "costoes-e-geologia-farol-de-ponta-negra", "placeName": "Farol de Ponta Negra"}, {"author": "Beatriz R.", "text": "Trilha cercada de árvores enormes. Ouvimos muitos pássaros.", "stars": 4, "date": "2026-11-09T16:23:00Z", "placeId": "mata-atlantica-pedra-do-silvado", "placeName": "Pedra do Silvado"}, {"author": "Bruna O.", "text": "Fui com o grupo da escola e foi uma aula ao ar livre sobre conservação.", "stars": 5, "date": "2026-11-08T22:30:00Z", "placeId": "areas-protegidas-ilha-cardosa", "placeName": "Ilha Cardosa"}, {"author": "Carlos P.", "text": "Fui com o grupo da escola e foi uma aula ao ar livre sobre conservação.", "stars": 5, "date": "2026-11-08T19:14:00Z", "placeId": "areas-protegidas-ponta-do-fundao", "placeName": "Ponta do Fundão"}, {"author": "Ana V.", "text": "Lugar lindo e silencioso. Respeitem as placas e fiquem na trilha.", "stars": 3, "date": "2026-11-08T16:04:00Z", "placeId": "areas-protegidas-caminhos-de-darwin", "placeName": "Caminhos de Darwin"}, {"author": "Caio O.", "text": "Ambiente selvagem e tranquilo, perfeito para quem gosta de natureza.", "stars": 4, "date": "2026-11-07T16:35:00Z", "placeId": "praias-e-restinga-praia-de-cordeirinho", "placeName": "Praia de Cordeirinho"}, {"author": "Gabriela L.", "text": "Fui no fim de semana e estava cheia, mas o pessoal estava cuidando bem.", "stars": 4, "date": "2026-11-05T23:47:00Z", "placeId": "praias-e-restinga-praia-da-barra-de-marica", "placeName": "Praia da Barra de Maricá"}, {"author": "Beatriz M.", "text": "Encontrei algumas embalagens na trilha e trouxe comigo. Vamos cuidar!", "stars": 5, "date": "2026-11-04T23:48:00Z", "placeId": "areas-protegidas-farol-das-ilhas-maricas", "placeName": "Farol das Ilhas Maricás"}, {"author": "Diego F.", "text": "Aprendemos muito sobre o meio ambiente da região. Ótimo para escolas.", "stars": 5, "date": "2026-11-04T19:53:00Z", "placeId": "educacao-ambiental-comunidade-pesqueira-de-zacarias-restinga-de-marica", "placeName": "Comunidade Pesqueira De Zacarias (Restinga de Maricá)"}, {"author": "Aline F.", "text": "Lugar mágico. Fizemos silêncio e vimos um tucano!", "stars": 5, "date": "2026-11-04T17:10:00Z", "placeId": "mata-atlantica-cachoeira-do-espraiado", "placeName": "Cachoeira do Espraiado"}, {"author": "Vanessa T.", "text": "Ambiente familiar. Pena ver gente jogando comida para os peixes.", "stars": 4, "date": "2026-11-02T21:30:00Z", "placeId": "lagoas-orla-de-itapeba", "placeName": "Orla de Itapeba"}, {"author": "Rafael M.", "text": "Compramos direto dos produtores, sem sacolinha plástica!", "stars": 4, "date": "2026-10-30T23:35:00Z", "placeId": "educacao-ambiental-aldeia-indigena-mata-verde-bonita", "placeName": "Aldeia Indígena Mata Verde Bonita"}, {"author": "Larissa N.", "text": "Lugar mágico. Fizemos silêncio e vimos um tucano!", "stars": 3, "date": "2026-10-29T17:58:00Z", "placeId": "mata-atlantica-pico-da-lagoinha", "placeName": "Pico da Lagoinha"}, {"author": "Caio M.", "text": "Muita gente riscando as pedras, que pena. Vamos preservar!", "stars": 5, "date": "2026-10-29T11:53:00Z", "placeId": "costoes-e-geologia-gruta-da-sacristia", "placeName": "Gruta da Sacristia"}, {"author": "Juliana N.", "text": "Praia linda e limpa. Recolhemos bitucas na saída, faz diferença.", "stars": 5, "date": "2026-10-27T13:03:00Z", "placeId": "restauracao-ecologica-praia-de-ponta-negra", "placeName": "Praia de Ponta Negra"}], "meta": {"areas-protegidas-parque-ecologico": {"nome": "Parque Ecológico", "categoria": "Áreas Protegidas", "bairro": "", "protegida": true}, "areas-protegidas-pedra-do-elefante": {"nome": "Pedra do Elefante", "categoria": "Áreas Protegidas", "bairro": "", "protegida": true}, "areas-protegidas-pedra-de-itaocaia": {"nome": "Pedra de Itaocaia", "categoria": "Áreas Protegidas", "bairro": "", "protegida": true}, "areas-protegidas-caminhos-de-darwin": {"nome": "Caminhos de Darwin", "categoria": "Áreas Protegidas", "bairro": "", "protegida": true}, "areas-protegidas-mira